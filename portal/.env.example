# Alberta Health Portal - Environment Variables
# Copy to .env.local and fill in values

# NextAuth.js (required — generate with: openssl rand -base64 32)
AUTH_SECRET=

# Model mode: controls which AI providers are available
#   beta-azure-ca  — Azure OpenAI Canada East only (default; required for beta data residency)
#   multi          — BYOK multi-provider (future; re-enable when BYOK is productized)
PORTAL_MODEL_MODE=beta-azure-ca

# Azure OpenAI — Canada East (required when PORTAL_MODEL_MODE=beta-azure-ca)
# Resource: abhealthmcp-openai-cae (Canada East)
# Deployment: gpt-4o (GPT-4o 2024-11-20), 10K TPM
AZURE_OPENAI_RESOURCE_NAME=abhealthmcp-openai-cae
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_KEY=<your-key-here>
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Legacy server-side OpenAI key (used in multi mode only; not needed for beta)
# OPENAI_API_KEY=

# Future: Additional providers (Phase 2 - BYOK, multi mode only)
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Database (Phase 1.2 - Cosmos DB)
# COSMOS_DB_ENDPOINT=
# COSMOS_DB_KEY=

# Session encryption
# MHR_ENCRYPTION_KEY=

# Beta invite flow
# BETA_INVITE_SECRET — HMAC signing secret for portal-beta invite tokens (random 32+ bytes, hex-encoded)
#   Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETA_INVITE_SECRET=
# BETA_INVITE_ADMIN_KEY — Value required in x-admin-key header to issue portal-beta invites
BETA_INVITE_ADMIN_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
