# Alberta Health Portal - Environment Variables
# Copy to .env.local and fill in values

# NextAuth.js (required — generate with: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth (required for production sign-in)
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://www.myaihealth.ca/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Model mode: controls which AI providers are available
#   beta-azure-ca  — Azure AI Foundry Canada East only (default; required for beta data residency)
#   multi          — BYOK multi-provider (future; re-enable when BYOK is productized)
PORTAL_MODEL_MODE=beta-azure-ca

# ── Azure AI Foundry — Canada East (required when PORTAL_MODEL_MODE=beta-azure-ca) ──
#
# Option A (preferred): Foundry project endpoint
#   Get from Azure Portal → AI Foundry → your project → Overview → Endpoint
# AZURE_AI_FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project-name>
#
# Option B (legacy): Azure OpenAI resource name
#   Resource: abhealthmcp-openai-cae (Canada East)
# AZURE_OPENAI_RESOURCE_NAME=abhealthmcp-openai-cae
#
# Required for both options:
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_KEY=<your-key-here>
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Legacy server-side OpenAI key (used in multi mode only; not needed for beta)
# OPENAI_API_KEY=

# Future: Additional providers (Phase 2 - BYOK, multi mode only)
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Database (Phase 1.2 - Cosmos DB)
# COSMOS_DB_ENDPOINT=
# COSMOS_DB_KEY=

# Session encryption
# MHR_ENCRYPTION_KEY=

# Beta invite flow
# BETA_INVITE_SECRET — HMAC signing secret for portal-beta invite tokens (random 32+ bytes, hex-encoded)
#   Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETA_INVITE_SECRET=
# BETA_INVITE_ADMIN_KEY — Value required in x-admin-key header to issue portal-beta invites
BETA_INVITE_ADMIN_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
