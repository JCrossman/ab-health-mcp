# Alberta Health Portal - Environment Variables
# Copy to .env.local and fill in values

# NextAuth.js (required — generate with: openssl rand -base64 32)
AUTH_SECRET=

# AI Provider (MVP: OpenAI via Azure for Canadian data residency)
OPENAI_API_KEY=

# Future: Additional providers (Phase 2 - BYOK)
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Database (Phase 1.2 - Cosmos DB)
# COSMOS_DB_ENDPOINT=
# COSMOS_DB_KEY=

# Session encryption
# MHR_ENCRYPTION_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
