{
  "name": "ab-health-mcp",
  "version": "1.4.3",
  "description": "MCP server for Alberta My Health Records",
  "main": "build/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc",
    "build:css": "tailwindcss -i static/input.css -o static/styles.css --minify",
    "start": "node build/index.js",
    "start:http": "node build/server/http-index.js",
    "test": "vitest run",
    "test:bundle": "tsx scripts/verify-bundle.ts",
    "test:live": "tsx scripts/test-auth.ts",
    "lint": "tsc --noEmit --project tsconfig.tests.json",
    "deploy": "node scripts/deploy.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "mupdf": "^1.28.1",
    "parse5": "^8.0.1",
    "puppeteer-core": "^25.12.0",
    "tough-cookie": "^6.0.1",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/tough-cookie": "^4.0.5",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
