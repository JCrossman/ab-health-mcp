{
  "manifest_version": 3,
  "name": "Alberta Health MCP Connector",
  "version": "1.0.0",
  "description": "Securely connects Claude Desktop to your Alberta Health Records via the MCP server.",
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://myhealthrecords.alberta.ca/*",
    "https://myahsconnect.albertahealthservices.ca/*",
    "https://mcp.myaihealth.ca/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mcp.myaihealth.ca/authorize*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
